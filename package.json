{
  "name": "mega-equipamentos",
  "version": "0.2.51",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev:netlify": "npx -y netlify dev",
    "build": "node ./scripts/netlify/patch-angular-runtime.mjs && ng build",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "images:catalog": "node ./scripts/images/catalog-standardize.mjs",
    "images:categories": "node ./scripts/images/category-standardize.mjs",
    "images:institutional": "node ./scripts/images/institutional-standardize.mjs",
    "serve:ssr:mega-equipamentos": "node dist/mega-equipamentos/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.0.0-rc.3",
    "@angular/compiler": "22.0.0-rc.3",
    "@angular/core": "22.0.0-rc.3",
    "@angular/forms": "22.0.0-rc.3",
    "@angular/platform-browser": "22.0.0-rc.3",
    "@angular/platform-server": "22.0.0-rc.3",
    "@angular/router": "22.0.0-rc.3",
    "@angular/ssr": "22.0.0-rc.3",
    "@google/genai": "^2.7.0",
    "@maskito/angular": "^5.2.2",
    "@maskito/core": "^5.2.2",
    "@maskito/kit": "^5.2.2",
    "@netlify/functions": "^5.3.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@thiagoprazeres/parse-e2eid": "^1.0.1",
    "@thiagoprazeres/pix-static-brcode": "^1.0.1",
    "daisyui": "^5.5.20",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "ispb-banks": "^2.1.0",
    "jspdf": "^4.2.1",
    "lucide-angular": "^1.0.0",
    "origem-core": "github:thiagoprazeres/origem-core#d9e047bf1eb568cead29a38078739ad806f0de0e",
    "postcss": "^8.5.15",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "22.0.0-rc.3",
    "@angular/cli": "22.0.0-rc.3",
    "@angular/compiler-cli": "22.0.0-rc.3",
    "@netlify/angular-runtime": "^3.0.1",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "baseline-browser-mapping": "^2.10.33",
    "drizzle-kit": "^0.31.10",
    "jasmine-core": "~6.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "postcss": "^8.5.15",
    "tsx": "^4.22.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@angular/core": "$@angular/core",
